INTERPRET QUERY () FOR GRAPH SumoraFraudGraph { T = {Transaction.*}; PRINT T.size() AS txns; K = {Card.*}; PRINT K.size() AS cards; C = {Customer.*}; PRINT C.size() AS customers; CC = {ClosedCase.*}; PRINT CC.size() AS closed_cases; FC = {FraudCase.*}; PRINT FC.size() AS fraud_cases; IC = {IdentityCluster.*}; PRINT IC.size() AS clusters; DP2 = {DeviceProfile.*}; PRINT DP2.size() AS devices; EM = {EmailAddress.*}; PRINT EM.size() AS emails; BR = {BillingRegion.*}; PRINT BR.size() AS regions; FP = {FraudPattern.*}; PRINT FP.size() AS patterns; }
